[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/menu/battle_result_menu.gd" id="1"]

[node name="BattleResultMenu" type="CanvasLayer"]
script = ExtResource("1")

[node name="MarginContainer" type="MarginContainer" parent="."]

[node name="VBoxContainer" type="VBoxContainer" parent="MarginContainer"]

[node name="ResultLabel" type="Label" parent="MarginContainer/VBoxContainer"]
text = "战斗结果"

[node name="SummaryLabel" type="Label" parent="MarginContainer/VBoxContainer"]
text = "地图：\n回合："

[node name="PrimaryButton" type="Button" parent="MarginContainer/VBoxContainer"]
text = "继续"

[node name="SecondaryButton" type="Button" parent="MarginContainer/VBoxContainer"]
text = "返回标题"

[connection signal="pressed" from="MarginContainer/VBoxContainer/PrimaryButton" to="." method="_on_primary_pressed"]
[connection signal="pressed" from="MarginContainer/VBoxContainer/SecondaryButton" to="." method="_on_secondary_pressed"]
