text = "地图：
回合："

[node name="HSeparator" type="HSeparator" parent="MarginContainer/VBoxContainer"]
layout_mode = 2

[node name="UnitResultContainer" type="VBoxContainer" parent="MarginContainer/VBoxContainer"]
